$auditPath='.\Logs\AuditoriaRollback_20260727_141659.csv'; $items=@(Import-Csv -LiteralPath $auditPath | Where-Object Safe -eq 'True'); if($items.Count -ne 226){throw "Auditoria inválida: esperadas 226 entradas aprovadas, encontradas $($items.Count)."}; $rollbackLog=Join-Path (Resolve-Path '.\Logs').Path ('RollbackGRDs_'+(Get-Date -Format 'yyyyMMdd_HHmmss')+'.log'); Start-Transcript -LiteralPath $rollbackLog -Force|Out-Null; $secure=ConvertTo-SecureString '123456' -AsPlainText -Force; $removed=0; try { if(-not(New-PWLogin -DatasourceName '01SSRV305.ECSC.ECORODOVIAS.CORP:ecorodovias-pw-01' -UserName 'admin' -Password $secure)){throw 'Falha no login do rollback.'}; foreach($item in $items){ $id=[int]$item.ProjectID; $folder=Get-PWFolders -FolderID $id -JustOne -WarningAction SilentlyContinue; if(-not $folder){throw "Pasta não encontrada antes da exclusão: ProjectID=$id; $($item.Path)"}; $docs=@(Get-PWDocumentsBySearch -FolderID $id -JustThisFolder -WarningAction SilentlyContinue); if($docs.Count -ne 1 -or (($docs[0].Name -ne $item.Expected) -and ($docs[0].FileName -ne $item.Expected))){throw "Conteúdo divergente; rollback interrompido antes de excluir ProjectID=$id."}; Write-Host "[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss.fff')] Excluindo GRD ProjectID=${id}: $($item.Path)"; Remove-PWFolder -FolderID $id -RemoveDocuments -RemoveFolders -ProceedWithDelete -ErrorAction Stop|Out-Null; if(Get-PWFolders -FolderID $id -JustOne -WarningAction SilentlyContinue){throw "ProjectID=$id ainda existe após tentativa de exclusão."}; $removed++ }; $remaining=@($items|Where-Object{Get-PWFolders -FolderID ([int]$_.ProjectID) -JustOne -WarningAction SilentlyContinue}); Write-Host "ROLLBACK CONCLUÍDO: removidas=$removed; restantes=$($remaining.Count)."; if($remaining.Count){throw 'Há pastas restantes após a verificação final.'} } finally { try{Undo-PWLogin|Out-Null}catch{}; Stop-Transcript|Out-Null }; Write-Output "ROLLBACK_LOG=$rollbackLog"
